---
import { css } from "../../styled-system/css";

export interface Props {
  level: 2 | 3;
  text: string;
  className?: string;
}

const { level, text, className } = Astro.props;

const h2Style = css({
  textStyle: { base: "28_700_100", md: "36_700_100" },
  mb: { base: "16px", md: "24px" },
});

const h3Style = css({
  textStyle: { base: "20_700_100", md: "24_700_100" },
  mb: { base: "12px", md: "16px" },
});

const style = level === 2 ? h2Style : h3Style;

{
  level === 2 ? (
    <h2 class:list={[style, className]}>
      {text}
      <slot />
    </h2>
  ) : (
    <h3 class:list={[style, className]}>
      {text}
      <slot />
    </h3>
  );
}
---
